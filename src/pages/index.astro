---
import Base from '../layouts/Base.astro';
import BrowseNav from '../components/BrowseNav.astro';
import BirdGrid from '../components/BirdGrid.tsx';
import RandomBirds from '../components/RandomBirds.tsx';
import { norwegianBirds } from '../lib/species.server';
import { ArrowUpIcon } from '../components/icons';
import browse from '../components/BrowseNav.module.css';
import button from '../components/Button.module.css';

// The front page, Arter tab. Static. Both views are in the page: every bird seen in Norway, and
// (with #verden in the address) 24 random birds from the whole world.
const norwegian = norwegianBirds();
---

<Base
  title="Fuglebilder av over 11 000 arter"
  description="Søk og se store bilder av over 11 000 fuglearter fra hele verden."
  search
>
  <h1 class="visually-hidden">Finn en fugl</h1>
  <section class={browse.section} aria-label="Arter">
    <BrowseNav tab="arter" />
    <div data-area="norge">
      <BirdGrid birds={norwegian} />
    </div>
    <div data-area="verden">
      <!-- client:visible: hidden in the Norge view, so it loads and fetches once Verden shows -->
      <RandomBirds client:visible />
    </div>
  </section>
  <p class="totop">
    <a class:list={[button.button, button.ghost]} href="#top"><ArrowUpIcon />Til toppen</a>
  </p>
</Base>

<script>
  // Scroll up without adding #top to the URL (so Back leaves the page, and #verden stays), then
  // put focus at the top like the plain link would. Without JS the link still works.
  document.querySelector('.totop a')?.addEventListener('click', (e) => {
    e.preventDefault();
    const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top: 0, behavior: smooth ? 'smooth' : 'auto' });
    document.querySelector<HTMLElement>('.brand')?.focus({ preventScroll: true });
  });
</script>

<style>
  .totop {
    display: flex;
    justify-content: center;
    margin: var(--space-xl) 0 0;
  }
</style>
