---
import Base from '../layouts/Base.astro';
import SearchBox from '../components/SearchBox.tsx';
import RandomBirds from '../components/RandomBirds.tsx';
---

<Base>
  <section class="hero">
    <h1>Finn en fugl</h1>
    <p>Skriv navnet på norsk eller latin.</p>
    <SearchBox client:load variant="hero" />
  </section>
  <RandomBirds client:load />
</Base>

<style>
  .hero {
    padding: clamp(24px, 7vh, 72px) 0 0;
    text-align: center;
  }
  h1 {
    margin: 0 0 6px;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  p {
    margin: 0 0 28px;
    color: var(--muted);
    font-size: 1.1rem;
  }
</style>
