---
import Base from '../layouts/Base.astro';
import FamilyOverview, { type OverviewFamily } from '../components/FamilyOverview.tsx';
import { allFamilies, coverSpecies, familyPath, isExtinctFamily } from '../lib/families.server';
import { displayName } from '../lib/shared';

// Static: the families only change when the index is rebuilt.
export const prerender = true;

const families: OverviewFamily[] = allFamilies().map((f) => ({
  href: familyPath(f),
  label: displayName(f),
  world: f.species.length + f.extinct.length,
  norway: f.norwegian.length,
  photo: coverSpecies(f, false).photo!,
  photoNo: f.norwegian.length ? coverSpecies(f, true).photo! : null,
  extinct: isExtinctFamily(f),
}));
---

<Base
  title="Fuglefamilier"
  description="Alle verdens fuglefamilier fra A til Å. Se hvilke arter som hører til hver familie."
  search
>
  <!-- The Familier tab of the front page: same switch and tabs, so no back link or visible title -->
  <h1 class="visually-hidden">Fuglefamilier</h1>
  <FamilyOverview client:load families={families} />
</Base>
