---
import Base from '../../layouts/Base.astro';
import PhotoGrid from '../../components/PhotoGrid.tsx';
import SpeciesFacts from '../../components/SpeciesFacts.astro';
import BackLink from '../../components/BackLink.astro';
import { getSpeciesBySlug, isNorwegian } from '../../lib/species.server';
import { areaPath } from '../../lib/area';
import { familyPath, getFamilyOf } from '../../lib/families.server';
import { displayName, photoUrl, type Taxon } from '../../lib/shared';

// Lages ved første besøk, deretter mellomlagret av Vercel (ISR).
export const prerender = false;

const species = getSpeciesBySlug(Astro.params.slug ?? '');
// An empty 404 makes Astro render 404.astro (rewriting to a prerendered page isn't allowed here).
if (!species) return new Response(null, { status: 404 });

const taxon: Taxon = { id: species.id, sci: species.sci, name: species.name };

const title = species.name ?? species.sci;
const others = species.names.slice(1);
// Lower case mid-sentence ("Bilder av dompap"); Latin names keep their capital.
const inText = species.name?.toLocaleLowerCase('nb') ?? species.sci;

const family = getFamilyOf(species.id);
// A bird not seen in Norway is only in its family's Hele verden view, so link there
const familyHref = family && areaPath(familyPath(family), isNorwegian(species) ? 'norge' : 'verden');

---

<Base
  title={`Bilder av ${inText}`}
  description={`Se store bilder av ${species.name ? `${inText} (${species.sci})` : inText}.`}
  image={species.photo ? photoUrl(species.photo, 'large') : undefined}
  imageAlt={title}
  search
>
  <!-- Three parts: the way back; who the bird is (name beside a fact box on wide screens); the photos -->
  <header class="head">
    <BackLink />
    <div class="intro">
      <div class="who">
        {family && (
          <p class="family"><a href={familyHref}>{displayName(family)}</a></p>
        )}
        <h1 class:list={["page-title", "name", { latin: !species.name }]}>{title}</h1>
        {species.name && <p class="sci">{species.sci}</p>}
        {others.length > 0 && <p class="aka">Også kalt {others.join(', ')}</p>}
      </div>
      <SpeciesFacts
        redList={species.redList}
        introduced={species.introduced}
        extinct={species.extinct}
        name={species.name}
      />
    </div>
  </header>
  <PhotoGrid client:load taxon={taxon} />
</Base>

<style>
  .head {
    margin: var(--space-sm) 0 var(--space-lg);
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  /* Fact box to the right of the name, lined up with its last line */
  @media (min-width: 900px) {
    .intro {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--space-2xl);
    }
    .intro > :global(.facts) {
      flex: none;
      width: 26rem;
    }
  }
  /* The species name stays bigger than other page titles */
  .name {
    font-size: var(--text-display);
  }
  .latin {
    font-style: italic;
  }
  .sci {
    margin: var(--space-2xs) 0 0;
    color: var(--color-gray);
    font-style: italic;
    font-size: var(--text-lg);
  }
  .aka {
    margin: var(--space-2xs) 0 0;
    color: var(--color-gray);
  }
  /* Above the name, like a kicker */
  .family {
    margin: 0 0 var(--space-2xs);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-gray);
  }
  .family a {
    color: inherit;
    text-decoration: none;
  }
  .family a::after {
    content: ' ›' / '';
  }
  .family a:hover {
    color: var(--color-charcoal);
  }
</style>
