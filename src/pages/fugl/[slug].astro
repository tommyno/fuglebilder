---
import Base from '../../layouts/Base.astro';
import PhotoGrid from '../../components/PhotoGrid.tsx';
import { getSpeciesBySlug } from '../../lib/species.server';
import { snlUrl, type Taxon } from '../../lib/shared';
import grid from '../../components/Grid.module.css';

// Lages ved første besøk, deretter mellomlagret av Vercel (ISR).
export const prerender = false;

const species = getSpeciesBySlug(Astro.params.slug ?? '');
// An empty 404 makes Astro render 404.astro (rewriting to a prerendered page isn't allowed here).
if (!species) return new Response(null, { status: 404 });

const taxon: Taxon = { id: species.id, sci: species.sci, name: species.name };

const title = species.name ?? species.sci;
const others = species.names.slice(1);
---

<Base
  title={`${title} – Fuglebilder`}
  description={`Bilder av ${species.name ? `${species.name} (${species.sci})` : species.sci}.`}
  search
>
  <header class="head">
    <a class:list={[grid.chip, "back"]} href="/" data-back>
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"
        ><path d="M19 12H5M11 6l-6 6 6 6"></path></svg
      >
      Tilbake
    </a>
    <h1 class:list={["page-title", { latin: !species.name }]}>{title}</h1>
    {species.name && (
      <p class="sci">
        <a href={snlUrl(species.name)} target="_blank" rel="noopener" title="Les om fuglen i Store norske leksikon">{species.sci}</a>
      </p>
    )}
    {others.length > 0 && <p class="aka">Også kalt {others.join(', ')}</p>}
  </header>
  <PhotoGrid client:load taxon={taxon} />
</Base>

<style>
  .head {
    margin: var(--space-sm) 0 var(--space-lg);
  }
  /* Same pill as the front-page chips, with the arrow before the text */
  .back {
    margin-bottom: var(--space-sm);
    padding-left: var(--space-xs);
    text-decoration: none;
  }
  .back svg {
    width: 1.1em;
    height: 1.1em;
  }
  .latin {
    font-style: italic;
  }
  .sci {
    margin: var(--space-2xs) 0 0;
    color: var(--color-gray);
    font-style: italic;
  }
  .aka {
    margin: var(--space-3xs) 0 0;
    color: var(--color-gray);
  }
</style>

<script>
  // Came here from another page on the site? Go back to it, so the front page keeps its birds and scroll position.
  // Otherwise (shared link, new tab) the link just goes to the front page.
  document.querySelector('[data-back]')?.addEventListener('click', (e) => {
    const ref = document.referrer && new URL(document.referrer);
    if (ref && ref.origin === location.origin && history.length > 1) {
      e.preventDefault();
      history.back();
    }
  });
</script>
