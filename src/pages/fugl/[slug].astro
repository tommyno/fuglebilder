---
import Base from '../../layouts/Base.astro';
import PhotoGrid from '../../components/PhotoGrid.tsx';
import RedList from '../../components/RedList.astro';
import BackLink from '../../components/BackLink.astro';
import { getSpeciesBySlug } from '../../lib/species.server';
import { familyPath, getFamilyOf } from '../../lib/families.server';
import { displayName, photoUrl, snlUrl, type Taxon } from '../../lib/shared';

// Lages ved første besøk, deretter mellomlagret av Vercel (ISR).
export const prerender = false;

const species = getSpeciesBySlug(Astro.params.slug ?? '');
// An empty 404 makes Astro render 404.astro (rewriting to a prerendered page isn't allowed here).
if (!species) return new Response(null, { status: 404 });

const taxon: Taxon = { id: species.id, sci: species.sci, name: species.name };

const title = species.name ?? species.sci;
const others = species.names.slice(1);
// Lower case mid-sentence ("Bilder av dompap"); Latin names keep their capital.
const inText = species.name?.toLocaleLowerCase('nb') ?? species.sci;

const family = getFamilyOf(species.id);
// A bird not seen in Norway is only in the family page's world view
const familyHref = family && familyPath(family) + (family.norwegian.some((s) => s.id === species.id) ? '' : '#verden');

---

<Base
  title={`Bilder av ${inText}`}
  description={`Se store bilder av ${species.name ? `${inText} (${species.sci})` : inText}.`}
  image={species.photo ? photoUrl(species.photo, 'large') : undefined}
  imageAlt={title}
  search
>
  <!-- Compact: family, name, Latin name (to Store norske leksikon), with the status pills at the
       right; then the photos -->
  <header class="head">
    <BackLink />
    <div class="intro">
      <div>
        {family && (
          <p class="family"><a href={familyHref}>{displayName(family)}</a></p>
        )}
        <h1 class:list={["page-title", "name", { latin: !species.name }]}>{title}</h1>
        {species.name && (
          <p class="sci">
            <a href={snlUrl(species.name)} target="_blank" rel="noopener" title="Les om fuglen i Store norske leksikon">{species.sci}</a>
          </p>
        )}
        {others.length > 0 && <p class="aka">Også kalt {others.join(', ')}</p>}
      </div>
      <RedList redList={species.redList} introduced={species.introduced} extinct={species.extinct} />
    </div>
  </header>
  <PhotoGrid client:load taxon={taxon} />
</Base>

<style>
  .head {
    margin: var(--space-sm) 0 var(--space-lg);
  }
  /* Status pills at the right, level with the last line; under the name when there's no room */
  .intro {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-sm) var(--space-lg);
  }
  /* The species name stays bigger than other page titles */
  .name {
    font-size: var(--text-display);
  }
  .latin {
    font-style: italic;
  }
  .sci {
    margin: var(--space-2xs) 0 0;
    color: var(--color-gray);
    font-style: italic;
  }
  .sci a {
    color: inherit;
    text-underline-offset: 0.2em;
  }
  .aka {
    margin: var(--space-3xs) 0 0;
    color: var(--color-gray);
  }
  /* Above the name, like a kicker */
  .family {
    margin: 0 0 var(--space-2xs);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-gray);
  }
  .family a {
    color: inherit;
    text-decoration: none;
  }
  .family a::after {
    content: ' ›' / '';
  }
  .family a:hover {
    color: var(--color-charcoal);
  }
</style>
