---
import Base from '../layouts/Base.astro';
import SearchBox from '../components/SearchBox.tsx';
---

<Base title="Fant ikke siden – Fuglebilder">
  <section class="hero">
    <h1 class="page-title">Denne fuglen har fløyet sin vei</h1>
    <p>Vi fant ikke siden. Prøv å søke i stedet.</p>
    <SearchBox client:load />
  </section>
</Base>

<style>
  .hero {
    padding: var(--space-3xl) 0 var(--space-4xl);
    text-align: center;
  }
  p {
    margin: var(--space-xs) 0 var(--space-lg);
    color: var(--color-gray);
  }
</style>
