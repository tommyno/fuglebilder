---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Footer from '../components/Footer.astro';
import SearchBox from '../components/SearchBox.tsx';
import { HeartIcon } from '../components/icons';
import button from '../components/Button.module.css';

interface Props {
  title?: string;
  description?: string;
  /** Link preview image (og:image), absolute URL. Defaults to the logo card, public/og-image.png. */
  image?: string;
  /** What the image shows, for og:image:alt. */
  imageAlt?: string;
  /** Show the search box at the top. Always in the same spot, so it doesn't jump between pages. */
  search?: boolean;
}

const {
  title = 'Fuglebilder',
  description = 'Se store bilder av alle verdens fugler.',
  image,
  imageAlt,
  search = false,
} = Astro.props;

// Query left out: ?vis= and ?photo= are client state, and ISR caches the path only.
const url = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = image ?? new URL('/og-image.png', Astro.site).href;
const ogImageAlt = image ? imageAlt : 'Fuglebilder-logoen: en dompap';
---

<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Fuglebilder" />
    <meta property="og:locale" content="nb_NO" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="Fuglebilder" />
    <meta name="theme-color" content="#f7f6f3" /><!-- = --color-sand-light in variables.css -->
    <script is:inline>
      if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js');
    </script>
    <link rel="preconnect" href="https://inaturalist-open-data.s3.amazonaws.com" />
  </head>
  <body>
    <header class="top" id="top">
      <a class="brand" href="/"><Logo /><span>Fuglebilder</span></a>
      <a class:list={[button.button, button.ghost, "mybirds"]} href="/mine-fugler">
        <HeartIcon />
        Mine fugler
      </a>
    </header>
    <main>
      {
        search && (
          <div class="search">
            <SearchBox client:load />
          </div>
        )
      }
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  /* Footer at the bottom of the window even when the page is short. Not in global.css
     because it relies on this layout's three children. */
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
  }
  .top {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    max-width: var(--max);
    margin: 0 auto;
    padding: max(var(--space-sm), env(safe-area-inset-top)) var(--gutter) var(--space-2xs);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    text-decoration: none;
  }
  .mybirds :global(svg) {
    color: var(--color-red);
  }
  main {
    flex: 1;
    width: 100%;
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 var(--gutter) var(--space-2xl);
  }
  .search {
    padding-top: var(--page-top);
  }
</style>
