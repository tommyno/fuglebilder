---
// The same file is the favicon and the source of the app icons (scripts/build-icons.mjs),
// so the logo is drawn in one place only. Inlined, not an <img>: public files are served with
// max-age=0, so an <img> was fetched again on every page load and the logo flashed in late.
import svg from '../../public/favicon.svg?raw';
---

<span class="logo" aria-hidden="true" set:html={svg} />

<style>
  .logo {
    display: block;
    width: 1.6em;
    height: 1.6em;
    flex: none;
  }

  .logo :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
