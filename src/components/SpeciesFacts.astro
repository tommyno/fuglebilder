---
// Fact box on a species page, beside the name: Norway's and IUCN's red-list status, whether it's
// introduced in Norway or extinct, and a link to Store norske leksikon. Each with a label, so
// it reads as facts and not as buttons. Shows nothing when there is nothing to say.
import type { RedList } from '../lib/species.server';
import { snlUrl } from '../lib/shared';

interface Props {
  redList: RedList;
  /** introduced in Norway (iNat's checklist) */
  introduced: boolean;
  /** extinct by iNat's flag; shown when IUCN doesn't already say so (birds gone before 1500, like the moas) */
  extinct: boolean;
  /** Norwegian name, for the SNL link; none for species without one */
  name: string | null;
}
const { redList, introduced, extinct, name } = Astro.props;
const iucnExtinct = redList.world === 'EX' || redList.world === 'EW';

const WORDS: Record<string, string> = {
  EX: 'Utdødd',
  EW: 'Utdødd i det fri',
  RE: 'Utdødd',
  CR: 'Kritisk truet',
  EN: 'Sterkt truet',
  VU: 'Sårbar',
  NT: 'Nær truet',
  LC: 'Livskraftig',
  DD: 'Datamangel',
};

interface Entry {
  code: string;
  /** what's in the round badge */
  badge: string;
  text: string;
  /** smaller line under the text: "i Norge" */
  where?: string;
  /** tooltip: where the fact comes from */
  source: string;
}

type Maybe = Entry | false | null | undefined | '';

const redListEntries = (
  [
    redList.norway && { code: redList.norway, badge: redList.norway, text: WORDS[redList.norway], where: 'i Norge', source: 'Norsk rødliste for arter (Artsdatabanken)' },
    redList.world && {
      code: redList.world,
      badge: redList.world,
      text: WORDS[redList.world],
      // EX and EW already say it all
      where: iucnExtinct ? undefined : 'i verden',
      source: 'IUCNs rødliste',
    },
  ] as Maybe[]
).filter((e): e is Entry => !!e && !!e.text);

const statusEntries = (
  [
    introduced && { code: 'IN', badge: '↘', text: 'Innført', where: 'i Norge', source: 'Ikke naturlig hjemmehørende i Norge (iNaturalist)' },
    extinct && !iucnExtinct && { code: 'EX', badge: 'EX', text: 'Utdødd', source: 'Utdødd (iNaturalist)' },
  ] as Maybe[]
).filter((e): e is Entry => !!e);

const any = redListEntries.length > 0 || statusEntries.length > 0 || !!name;
---

{any && (
  <dl class="facts">
    {[
      { label: 'Rødliste', entries: redListEntries },
      { label: 'Status', entries: statusEntries },
    ].map(
      (row) =>
        row.entries.length > 0 && (
          <div class="row">
            <dt>{row.label}</dt>
            <dd>
              <ul class="entries">
                {row.entries.map((e) => (
                  <li class="entry" title={e.source}>
                    <span class:list={['code', e.code.toLowerCase()]} aria-hidden="true">{e.badge}</span>
                    <span class="words">
                      <span class="text">{e.text}</span>
                      {e.where && <span class="where">{e.where}</span>}
                    </span>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        ),
    )}
    {name && (
      <div class="row inline">
        <dt>Les mer</dt>
        <dd>
          <a href={snlUrl(name)} target="_blank" rel="noopener">
            Store norske leksikon
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              ><path d="M7 17 17 7M8 7h9v9"></path></svg
            >
          </a>
        </dd>
      </div>
    )}
  </dl>
)}

<style>
  .facts {
    margin: 0;
    border: 1px solid var(--color-black-10);
    border-radius: var(--radius-md);
    background: var(--color-white);
  }
  .row {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-sm) var(--space-md);
  }
  .row + .row {
    border-top: 1px solid var(--color-black-10);
  }
  /* A single value: label left, value right */
  .inline {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
  }
  dt {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-gray);
  }
  dd {
    margin: 0;
  }
  dd a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: var(--control-xs);
    color: inherit;
    text-underline-offset: 0.2em;
  }
  dd svg {
    width: 1em;
    height: 1em;
  }
  .entries {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .entry {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }
  .words {
    display: flex;
    flex-direction: column;
    line-height: var(--leading-tight);
  }
  .text {
    font-weight: var(--weight-medium);
  }
  .where {
    font-size: var(--text-sm);
    color: var(--color-gray);
  }
  .code {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--control-xs);
    height: var(--control-xs);
    border-radius: var(--radius-full);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-charcoal);
  }
  /* IUCN's category colours; white text on the dark ones */
  .ex { background: var(--redlist-ex); color: var(--color-white); }
  .ew { background: var(--redlist-ew); color: var(--color-white); }
  .re { background: var(--redlist-re); color: var(--color-white); }
  .cr { background: var(--redlist-cr); color: var(--color-white); }
  .en { background: var(--redlist-en); }
  .vu { background: var(--redlist-vu); }
  .nt { background: var(--redlist-nt); }
  .lc { background: var(--redlist-lc); }
  .dd { background: var(--redlist-dd); }
  /* Introduced: not a red-list category, so plain grey from our own palette */
  .in { background: var(--color-gray); color: var(--color-white); font-size: var(--text-sm); }
</style>
